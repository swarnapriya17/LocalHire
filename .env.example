# ==============================================================================
# LocalHire — Workspace Environment Configuration Overview
# ==============================================================================
# LocalHire consists of two services:
# 1. Backend API (server/)  — Express.js + Mongoose + Node.js
# 2. Frontend Client (client/) — React 19 + Vite SPA
#
# Create individual .env files in server/ and client/ directories as follows:
#
# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (server/.env)
# ------------------------------------------------------------------------------
# PORT=5000
# NODE_ENV=development
# CLIENT_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/localhire?retryWrites=true&w=majority
# JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
# JWT_EXPIRES_IN=7d
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_or_openai_api_key_here
# LLM_MODEL=gemini-1.5-flash
# LLM_FALLBACK_MODEL=gemini-1.5-flash-8b
# LLM_MAX_RETRIES=3
# LLM_RETRY_DELAY_MS=500
# LLM_TIMEOUT_MS=45000
#
# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (client/.env)
# ------------------------------------------------------------------------------
# In local development: defaults to '/api' which is proxied by Vite dev server
# In production (e.g. Vercel):
# VITE_API_URL=https://<your-render-service-name>.onrender.com/api
# ==============================================================================
