# ==============================================================================
# LocalHire — Server Environment Configuration Template
# Copy this file to server/.env and populate with your credentials.
# NEVER commit server/.env or publish secret keys to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (used for CORS origin allowance and cookie delivery)
# In production on Render, set this to your Vercel deployment URL (e.g. https://localhire.vercel.app)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Database Connection (MongoDB Atlas)
# ==============================================================================
# Required for persistent account registration, login, and profile storage.
# How to get your connection string from MongoDB Atlas:
# 1. Sign up / Log in to MongoDB Atlas (https://www.mongodb.com/atlas)
# 2. In your Cluster, click "Connect" -> "Drivers" -> Select "Node.js"
# 3. Copy the connection string and replace <username> and <password> with your database user credentials.
# 4. In Atlas Network Access, ensure your IP address (or 0.0.0.0/0 for production hosting like Render) is allowlisted.
# Format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/localhire?retryWrites=true&w=majority

# ==============================================================================
# JWT Authentication Secrets
# ==============================================================================
# A strong, cryptographically random secret key used to sign session tokens (min 32 characters)
# Generate a secure key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# ==============================================================================
# AI Career Assistant Configuration (Google Gemini / OpenAI)
# ==============================================================================
# Provider selection: 'gemini' (recommended) or 'openai'
LLM_PROVIDER=gemini

# API key for the selected provider:
# - Google Gemini: Obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
# - OpenAI: Obtain from OpenAI Platform (https://platform.openai.com/api-keys)
LLM_API_KEY=your_gemini_or_openai_api_key_here

# Model name:
# Verified Google Gemini models: gemini-1.5-flash (recommended for speed/quota), gemini-2.0-flash, gemini-1.5-pro
# Verified OpenAI models: gpt-4o-mini (recommended), gpt-4o
LLM_MODEL=gemini-1.5-flash

# Fallback model used automatically when primary model experiences high load (HTTP 503) or rate limits
LLM_FALLBACK_MODEL=gemini-1.5-flash-8b

# AI Retry and Resiliency Tuning
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_MS=500
LLM_TIMEOUT_MS=45000

# Optional custom OpenAI-compatible API base URL (leave empty when using default public API)
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# ==============================================================================
# Optional Admin Provisioning Variables (used if not passed via CLI arguments)
# ==============================================================================
# ADMIN_EMAIL=admin@localhire.in
# ADMIN_PASSWORD=YourSecureAdminPassword123!
# ADMIN_NAME=LocalHire Administrator
